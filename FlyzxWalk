end)

-------------------------------------------------
-- Movimiento Bypass
-------------------------------------------------
local function moverA(destino)
	if not root or not root.Parent then return false end

	local inicio = tick()
	while (root.Position - destino).Magnitude > 3.5 do
		if not activo or not root or not root.Parent then return false end
		if tick() - inicio > 12 then return false end

		local dir = (destino - root.Position).Unit
		local move = dir * velocidad * RunService.Heartbeat:Wait()
		root.CFrame = CFrame.new(root.Position + move) * CFrame.Angles(0, math.atan2(-dir.X, -dir.Z), 0)
	end

	root.CFrame = CFrame.new(destino.X, root.Position.Y, destino.Z)
	return true
end

