toggle.MouseButton1Click:Connect(function()
	activo = not activo
	actualizar()
end)

-------------------------------------------------
-- Bucle
-------------------------------------------------
task.spawn(function()
	while true do
		if activo and root and root.Parent then
			for i, destino in ipairs(puntos) do
				if not activo then break end
				puntoActual = i
				actualizar()
				moverA(destino)
				task.wait(0.12)
			end
		else
			task.wait(0.2)
		end
	end
end)

