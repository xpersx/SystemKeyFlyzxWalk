local function actualizar()
	speedLabel.Text = "Velocidad: " .. velocidad
	if activo then
		status.Text = "Estado: Activo"
		status.TextColor3 = Color3.fromRGB(90, 255, 150)
		toggle.Text = "DETENER"
		toggle.BackgroundColor3 = Color3.fromRGB(190, 50, 65)
		puntoLabel.Text = "Punto: " .. puntoActual .. " / 4"
	else
		status.Text = "Estado: Detenido"
		status.TextColor3 = Color3.fromRGB(170, 170, 185)
		toggle.Text = "INICIAR"
		toggle.BackgroundColor3 = Color3.fromRGB(0, 155, 95)
		puntoLabel.Text = "Punto: - / 4"
	end
end

